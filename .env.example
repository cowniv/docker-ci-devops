# --- API ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# postgres | json | memory  (defaults to postgres when DATABASE_URL is set, json otherwise)
STORE_DRIVER=json
DATA_FILE=data/notes.json
DATABASE_URL=postgres://notes:change-me@localhost:5432/notes
SHUTDOWN_TIMEOUT_MS=10000
CORS_ORIGIN=*

# --- docker compose ---
